# ---- Central server ------------------------------------------------------
POSTGRES_DB=military_stt
POSTGRES_USER=stt
POSTGRES_PASSWORD=change-me-postgres

CENTRAL_ENVIRONMENT=production
CENTRAL_DEBUG=false
# HS256 secret for user sessions. Use a long random value (>= 48 chars).
CENTRAL_JWT_SECRET=change-me-to-a-long-random-secret-value-0123456789
CENTRAL_ACCESS_TOKEN_EXPIRE_MINUTES=480
# Local Agent must accept a job within this window (seconds)
CENTRAL_PROCESSING_TOKEN_ACCEPT_TTL_SECONDS=600
# Results / audio for that job may still be synchronized within this window (seconds)
CENTRAL_PROCESSING_TOKEN_SUBMIT_TTL_SECONDS=86400
CENTRAL_MAX_UPLOAD_BYTES=2147483648
# Only needed for the Vite dev server (comma separated). Leave empty in production.
CENTRAL_CORS_ALLOWED_ORIGINS=

# First administrator (created only when the users table is empty)
CENTRAL_BOOTSTRAP_ADMIN_USERNAME=admin
CENTRAL_BOOTSTRAP_ADMIN_PASSWORD=ChangeMe!2026

# Published ports of the nginx reverse proxy
CENTRAL_HTTP_PORT=8080
CENTRAL_HTTPS_PORT=8443
