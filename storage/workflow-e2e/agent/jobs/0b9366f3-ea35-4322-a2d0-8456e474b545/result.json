  "segments": [
    {
      "speaker_label": "SPEAKER_00",
      "start_seconds": 1.11,
      "end_seconds": 3.29,
      "text": "أين كنت مساء أمس يا أحمد؟",
      "confidence": null,
      "is_overlap": false
    },
    {
      "speaker_label": "SPEAKER_00",
      "start_seconds": 4.52,
      "end_seconds": 9.37,
      "text": "أريد أن تخبرني بالتفصيل عن كل ما فعلته بعد الساعة السابعة.",
      "confidence": null,
      "is_overlap": false
    },
    {
      "speaker_label": "SPEAKER_01",
      "start_seconds": 11.4,
      "end_seconds": 13.51,
      "text": "كانت في المنزل طوال المساء",
      "confidence": null,
      "is_overlap": false
    },
    {
      "speaker_label": "SPEAKER_01",
      "start_seconds": 14.6,
      "end_seconds": 21.9,
      "text": "وصلت من العمل في السادسة والنصف وتناولت العشاء مع عائلتي ثم شاهدت التلفاز",
      "confidence": null,
      "is_overlap": false
    },
    {
      "speaker_label": "SPEAKER_00",
      "start_seconds": 23.91,
      "end_seconds": 26.65,
      "text": "هل كان معك أحد آخر في المنزل؟",
      "confidence": null,
      "is_overlap": false
    },
    {
      "speaker_label": "SPEAKER_00",
      "start_seconds": 27.7,
      "end_seconds": 30.77,
      "text": "وهل يستطيع أحد أن يؤكد ما تقوله؟",
      "confidence": null,
      "is_overlap": false
    },
    {
      "speaker_label": "SPEAKER_01",
      "start_seconds": 32.85,
      "end_seconds": 40.29,
      "text": "نعم كانت زوجتي وأولادي معي وجاء أخي في الساعة التاسعة وبقي حتى منتصف الليل",
      "confidence": null,
      "is_overlap": false
    },
    {
      "speaker_label": "SPEAKER_00",
      "start_seconds": 42.26,
      "end_seconds": 42.88,
      "text": "حسنا",
      "confidence": null,
      "is_overlap": false
    },
    {
      "speaker_label": "SPEAKER_00",
      "start_seconds": 44.0,
      "end_seconds": 45.75,
      "text": "سنتحقق من ذلك.",
      "confidence": null,
      "is_overlap": false
    },
    {
      "speaker_label": "SPEAKER_00",
      "start_seconds": 46.8,
      "end_seconds": 50.32,
      "text": "هل غادرت المنزل في أي وقت خلال تلك الليلة؟",
      "confidence": null,
      "is_overlap": false
    }
  ],
  "completed_at": "2026-10-26T21:48:42.161244+00:00"
