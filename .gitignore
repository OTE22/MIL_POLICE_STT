# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.venv/
venv/
.mypy_cache/

# Node
node_modules/
central/frontend/dist/

# Environment / secrets
.env
*.env.local
# Everything in secrets/ is a credential. Ignore the DIRECTORY's contents, not just *.pem:
# an api-key file (nvidia_api_key) has no extension and was slipping past the old pattern.
secrets/*
!secrets/.gitkeep
desktop-agent/secrets/*
!desktop-agent/secrets/.gitkeep

# Runtime data
storage/backups/
storage/recordings/
desktop-agent/data/
desktop-agent/models/
# NOT a bare "models/": that also matched central/backend/app/models/ and kept the
# entire ORM package - the database schema - out of the repository.
deploy/models/
*.sqlite3
*.db
logs/

# OS / IDE
.DS_Store
Thumbs.db
.vscode/
.idea/

# local test venvs
.venv-test/
.venv-test/
