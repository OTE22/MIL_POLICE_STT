[
  [
    {
      "text": "محضر تحقيق عدلي",
      "margin": "الجمهورية اللبنانية",
      "bold": false
    },
    {
      "text": "",
      "margin": "وزارة الدفاع الوطني",
      "bold": false
    },
    {
      "text": "في الساعة التاسعة والنصف من يوم الأربعاء الواقع في الحادي",
      "margin": "الشرطة العسكرية",
      "bold": false
    },
    {
      "text": "والعشرين من شهر تشرين الأول سنة ألفين وست وعشرين",
      "margin": "خفر افتراضي",
      "bold": false
    },
    {
      "text": "نحن نقيب المحقق التجريبي (تجريبي) الضابط العدلي العسكري في وحدة",
      "margin": "موضوع القضية",
      "bold": false
    },
    {
      "text": "افتراضية",
      "margin": "",
      "bold": false
    },
    {
      "text": "والمصحوبون بـرقيب الكاتب التجريبي رقم تجريبي من الوحدة",
      "margin": "",
      "bold": false
    },
    {
      "text": "الافتراضية والذي اتخذناه كاتباً عدلياً",
      "margin": "",
      "bold": false
    },
    {
      "text": "بعد أن قمنا بتحليفه اليمين القانونية لمرة واحدة فقط على الشكل",
      "margin": "",
      "bold": false
    },
    {
      "text": "التالي: «والله العظيم أني أقوم بواجبي بكل أمانة وإخلاص وأحفظ سر",
      "margin": "",
      "bold": false
    },
    {
      "text": "التحقيق»",
      "margin": "",
      "bold": false
    },
    {
      "text": "والمرتدون اللباس العسكري",
      "margin": "",
      "bold": false
    },
    {
      "text": "نثبت أنه في الساعة والتاريخ المذكورين أعلاه اجتمعنا في مكتب",
      "margin": "",
      "bold": false
    },
    {
      "text": "افتراضي واستناداً للإحالة رقم تجريبي تاريخ ٢١/١٠/٢٠٢٦ والمتعلقة",
      "margin": "",
      "bold": false
    },
    {
      "text": "بإجراء تحقيق عدلي حول واقعة افتراضية لاختبار القالب باشرنا",
      "margin": "",
      "bold": false
    },
    {
      "text": "التحقيق على الشكل التالي:",
      "margin": "",
      "bold": false
    },
    {
      "text": "إفادة رقيب أول المشارك التجريبي رقم تجريبي",
      "margin": "",
      "bold": true
    },
    {
      "text": "اسمي المشارك التجريبي بن الأب التجريبي ووالدتي الأم التجريبية",
      "margin": "س.ج",
      "bold": false
    },
    {
      "text": "مولود عام ١٩٩٠ في بلدة البلدة الافتراضية قضاء القضاء الافتراضي",
      "margin": "",
      "bold": false
    },
    {
      "text": "رقم سجل النفوس تجريبي ومقيم حالياً في عنوان افتراضي رقم الهاتف",
      "margin": "",
      "bold": false
    },
    {
      "text": "غير مدخل متأهل وله ولدان متعلم تعليماً افتراضياً أعمل بوظيفة",
      "margin": "",
      "bold": false
    },
    {
      "text": "افتراضية في وحدة تدريبية [إفادة السوابق يراجعها المحقق]",
      "margin": "",
      "bold": false
    },
    {
      "text": "تأكدنا من [وثائق راجعها المحقق] وأعيدت إليه",
      "margin": "",
      "bold": false
    },
    {
      "text": "أفيد أنني حضرت إلى المكتب الافتراضي في الموعد المحدد، وقد رتبت",
      "margin": "س.ج",
      "bold": false
    },
    {
      "text": "المواد التجريبية وراجعت عناوينها. هذه بيانات افتراضية لا تصف",
      "margin": "",
      "bold": false
    },
    {
      "text": "واقعة حقيقية.",
      "margin": "",
      "bold": false
    },
    {
      "text": "نعم قمت بمراجعة ترتيب الملفات التجريبية ولم أضف أي معلومات",
      "margin": "س.ج",
      "bold": false
    },
    {
      "text": "شخصية إليها.",
      "margin": "",
      "bold": false
    }
  ],
  [
    {
      "text": "",
      "margin": "هامش",
      "bold": false
    },
    {
      "text": "كلا ليس لدي ما أضيفه على إفادتي التجريبية هذه.",
      "margin": "س.ج",
      "bold": false
    },
    {
      "text": "",
      "margin": "",
      "bold": false
    },
    {
      "text": "",
      "margin": "",
      "bold": false
    },
    {
      "text": "",
      "margin": "",
      "bold": false
    },
    {
      "text": "",
      "margin": "",
      "bold": false
    },
    {
      "text": "تليت عليه إفادته فصدقها ووقعها بحضورنا نحن والكاتب العدلي",
      "margin": "",
      "bold": false
    },
    {
      "text": "رقيب أول مستجوب __________ كاتب عدلي __________ مكان افتراضي في",
      "margin": "",
      "bold": false
    },
    {
      "text": "٢١/١٠/٢٠٢٦",
      "margin": "",
      "bold": false
    },
    {
      "text": "نقيب محقق __________",
      "margin": "",
      "bold": false
    },
    {
      "text": "بتاريخ ٢١/١٠/٢٠٢٦ الساعة ١٢:٠٠ وبمراجعة قيادة الوحدة الافتراضية",
      "margin": "ملاحظة:",
      "bold": false
    },
    {
      "text": "بشخص رتبة افتراضية المسؤول التجريبي واطلاعه على تفاصيل التحقيق",
      "margin": "",
      "bold": false
    },
    {
      "text": "[قرار إجرائي يؤكده المراجع] ولأجله سطرت.",
      "margin": "",
      "bold": false
    },
    {
      "text": "رقيب أول مستجوب __________ كاتب عدلي __________ مكان افتراضي في",
      "margin": "",
      "bold": false
    },
    {
      "text": "٢١/١٠/٢٠٢٦",
      "margin": "",
      "bold": false
    },
    {
      "text": "نقيب محقق __________",
      "margin": "",
      "bold": false
    },
    {
      "text": "نظم وختم هذا التحقيق على نسخة واحدة في [عدد صفحات هذا الجزء]",
      "margin": "",
      "bold": false
    },
    {
      "text": "ووقع من قبلنا نحن والكاتب العدلي يقدم مع [المرفقات الفعلية]",
      "margin": "",
      "bold": false
    },
    {
      "text": "للتفضل بالإطلاع",
      "margin": "",
      "bold": false
    },
    {
      "text": "رقيب أول مستجوب __________ كاتب عدلي __________ مكان افتراضي في",
      "margin": "",
      "bold": false
    },
    {
      "text": "٢١/١٠/٢٠٢٦",
      "margin": "",
      "bold": false
    },
    {
      "text": "نقيب محقق __________",
      "margin": "",
      "bold": false
    },
    {
      "text": "يستنتج من سياق التحقيق أنه [استنتاج يكتبه المراجع]",
      "margin": "الإستنتاج:",
      "bold": false
    },
    {
      "text": "",
      "margin": "",
      "bold": false
    },
    {
      "text": "",
      "margin": "",
      "bold": false
    },
    {
      "text": "",
      "margin": "",
      "bold": false
    },
    {
      "text": "تترتب على [الرتبة] [الاسم] رقم [الرقم] من عداد [الوحدة]",
      "margin": "المسؤوليات:",
      "bold": false
    },
    {
      "text": "المسؤولية التالية: [مسؤوليات يحددها المراجع]",
      "margin": "",
      "bold": false
    }
