* text=auto eol=lf

# Shell scripts and container entrypoints MUST stay LF: a CRLF shebang fails on
# Linux with "bad interpreter".
*.sh text eol=lf
Dockerfile text eol=lf
*.service text eol=lf

# Windows-only helpers stay CRLF.
*.ps1 text eol=crlf

# Never normalise binary payloads.
*.nemo binary
*.safetensors binary
*.wav binary
*.pem binary
