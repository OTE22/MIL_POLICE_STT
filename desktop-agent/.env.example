# ---- Local AI Agent --------------------------------------------------------
AGENT_BIND_HOST=127.0.0.1
AGENT_PORT=17117
# Only an administrator may change the bind address (e.g. inside Docker: 0.0.0.0 + published on 127.0.0.1)
AGENT_ALLOW_NON_LOOPBACK_BIND=false
AGENT_DEVICE_NAME=
AGENT_LOG_LEVEL=INFO
# Browser origins of the central frontend allowed to call this agent
AGENT_ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,https://localhost:8443,https://central.example.local:8443

# Storage (Windows defaults: C:\ProgramData\InvestigationAI\{agent,models})
AGENT_DATA_DIR=C:\ProgramData\InvestigationAI\agent
AGENT_MODEL_DIR=C:\ProgramData\InvestigationAI\models
AGENT_TEMP_RETENTION_HOURS=72

# STT - WHAT WAS SAID (local Cohere model)
AGENT_STT_PROVIDER=cohere_local
AGENT_STT_MODEL=CohereLabs/cohere-transcribe-arabic-07-2026
AGENT_STT_MODEL_REVISION=c3e911b42149bf7a1e53d5cef9878aee87515a23
AGENT_STT_LANGUAGE=ar
AGENT_STT_DEVICE=auto
AGENT_STT_DTYPE=auto

# Diarization - WHO SPOKE WHEN (local NVIDIA Sortformer)
AGENT_DIARIZATION_PROVIDER=nvidia_sortformer
AGENT_DIARIZATION_MODEL=nvidia/diar_streaming_sortformer_4spk-v2.1
AGENT_DIARIZATION_MODEL_REVISION=fafaab5faa1617a0ca52d38dd3dc4bd636800d3d
AGENT_DIARIZATION_DEVICE=auto

# VAD
AGENT_VAD_ENABLED=true
AGENT_VAD_THRESHOLD=0.5
AGENT_VAD_MIN_SPEECH_MS=250
AGENT_VAD_MIN_SILENCE_MS=300

# Segment post-processing
AGENT_SEGMENT_MIN_TURN_SECONDS=0.3
AGENT_SEGMENT_MERGE_GAP_SECONDS=0.7
AGENT_SEGMENT_MAX_SECONDS=28
AGENT_SEGMENT_CONTEXT_PADDING_SECONDS=0.3

# Models lifecycle
AGENT_PRELOAD_MODELS=false
AGENT_VERIFY_MODEL_INTEGRITY=size

# Central server
AGENT_CENTRAL_URL=https://central.example.local:8443
AGENT_CENTRAL_SYNC_ENABLED=true
AGENT_CENTRAL_UPLOAD_AUDIO=true
AGENT_CENTRAL_VERIFY_TLS=true
# AGENT_CENTRAL_CA_BUNDLE=C:\ProgramData\InvestigationAI\central-ca.pem
# Public verification key installed at provisioning time (never the private key)
AGENT_CENTRAL_PUBLIC_KEY_PATH=C:\ProgramData\InvestigationAI\central_public_key.pem
AGENT_CENTRAL_PUBLIC_KEY_AUTO_FETCH=false
